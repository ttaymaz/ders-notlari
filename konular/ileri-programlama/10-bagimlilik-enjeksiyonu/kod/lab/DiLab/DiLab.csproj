<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Servisler ILogger<T> ve IOptions<T> kullanır; bu ikisinin yalnızca
       soyutlamaları gerekir. Gerçek günlükçü ve yapılandırma uygulamada
       (Generic Host) bağlanır. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

</Project>
